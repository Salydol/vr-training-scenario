  m_Name: WarehouseShiftScenario
  m_EditorClassIdentifier: VRTraining::VRTraining.Scenario.Data.ScenarioData
  title: "\u0421\u043C\u0435\u043D\u0430 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435"
  groups:
  - title: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432"
    steps:
    - description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0441\u0442\u043E\u0439\u043A\u0435 \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438"
      actions:
      - type: 0
        targetId: zone_desk
    - description: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u043A \u0441\u043E \u0441\u0442\u043E\u0439\u043A\u0438"
      actions:
      - type: 1
        targetId: pass
    - description: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C\xBB \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438"
      actions:
      - type: 3
        targetId: btn_confirm
  - title: "\u041E\u0441\u043C\u043E\u0442\u0440 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F"
    steps:
    - description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0449\u0438\u0442\u043A\u0443 \u0438 \u043A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043B\u0443\u0447\u043E\u043C \u043F\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u0435"
      actions:
      - type: 0
        targetId: zone_panel
      - type: 2
        targetId: lamp_red
    - description: "\u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043B\u0443\u0447\u043E\u043C \u043F\u043E \u0437\u0435\u043B\u0451\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u0435"
      actions:
      - type: 2
        targetId: lamp_green
    - description: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043E\u0433\u043D\u0435\u0442\u0443\u0448\u0438\u0442\u0435\u043B\u044C"
      actions:
      - type: 1
        targetId: extinguisher
  - title: "\u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u0441\u043C\u0435\u043D\u044B"
    steps:
    - description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0432\u044B\u0445\u043E\u0434\u0443"
      actions:
      - type: 0
        targetId: zone_exit
    - description: "\u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A \u043A\u043B\u0438\u043A\u043E\u043C \u043B\u0443\u0447\u0430"
      actions:
      - type: 2
        targetId: switch
    - description: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0441\u043C\u0435\u043D\u0443\xBB \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438"
      actions:
      - type: 3
        targetId: btn_finish
